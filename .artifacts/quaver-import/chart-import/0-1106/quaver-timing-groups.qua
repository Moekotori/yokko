Mode: Keys4
Title: Timing Groups
BPMDoesNotAffectScrollVelocity: true
InitialScrollVelocity: 1
TimingPoints:
  - StartTime: 0
    Bpm: 120
SliderVelocities:
  - StartTime: 500
    Multiplier: 2
TimingGroups:
  "$Global": !ScrollGroup
    ScrollVelocities:
      - StartTime: 750
        Multiplier: 0.5
  Reverse: !ScrollGroup
    ScrollVelocities:
      - StartTime: 750
        Multiplier: 8
      - StartTime: 1000
        Multiplier: -2
    ScrollSpeedFactors:
      - StartTime: 0
        Multiplier: 1.5
    InitialScrollVelocity: -1
HitObjects:
  - StartTime: 1500
    Lane: 1
  - StartTime: 1600
    Lane: 2
    TimingGroup: Reverse